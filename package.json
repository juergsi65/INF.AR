{
  "name": "infrasight-ar",
  "version": "0.1.0",
  "description": "AR-Visualisierung von Leitungsinfrastruktur (Trassen, Rohre, Kabel, Schächte) – deploybar auf Cloudflare Workers",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.worker.json && vite build",
    "preview": "npm run build && wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "leaflet": "^1.9.4",
    "proj4": "^2.22.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/leaflet": "^1.9.22",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "private": true,
  "type": "module"
}
