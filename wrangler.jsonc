{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infrasight-ar",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
  // Optional: serverseitige Projekt-Speicherung in Cloudflare KV.
  // 1) npx wrangler kv namespace create PROJECTS
  // 2) die ausgegebene ID hier eintragen und den Block einkommentieren
  // 3) Schreibschutz: npx wrangler secret put API_TOKEN
  // ,"kv_namespaces": [{ "binding": "PROJECTS", "id": "<KV_NAMESPACE_ID>" }]
}
